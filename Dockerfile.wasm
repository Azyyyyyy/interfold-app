# syntax=docker/dockerfile:1.7

# Builder is pinned to $BUILDPLATFORM so the Gradle/Kotlin-Wasm compile
# always runs natively on the CI host architecture (typically linux/amd64).
# This is required because Temurin has no linux/arm/v7 JDK tag — without it,
# `buildx --platform linux/arm/v7` would fail to pull the base image.
# The Wasm bundle produced is CPU-architecture-neutral, so the per-arch
# runtime stages below all consume the same artifact.
FROM --platform=$BUILDPLATFORM eclipse-temurin:21-jdk-jammy AS builder

WORKDIR /workspace

# Central AppVersion inputs — see the "Centralised app versioning" block in
# the root build.gradle.kts. Empty defaults mean "local build"; GHA sets
# these via docker/build-push-action's `build-args`.
ARG APPVERSION_RUN_NUMBER=""
ARG APPVERSION_TAG=""
ARG APPVERSION_RELEASE_NAME=""

# Install system dependencies required for Node.js and build tools
RUN apt-get update && apt-get install -y \
    libatomic1 \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN sed -i 's/\r$//' ./gradlew && chmod +x ./gradlew

# BuildKit cache mounts:
#   /root/.gradle                       - Gradle dependency + build cache (avoids re-downloading)
#   /root/.local/share/kotlin/...       - Kotlin/Native toolchain
#   /workspace/.gradle                  - Gradle configuration cache (avoids full reconfiguration
#                                         on every build; enables incremental compilation on code changes)
RUN --mount=type=cache,id=interfold-gradle-cache,target=/root/.gradle,sharing=locked \
    --mount=type=cache,id=interfold-kotlin-native-cache,target=/root/.local/share/kotlin/kotlinNative,sharing=locked \
    --mount=type=cache,id=interfold-workspace-gradle-cache,target=/workspace/.gradle,sharing=locked \
    ./gradlew --no-daemon -Dorg.gradle.internal.http.connectionTimeout=120000 \
              -Dorg.gradle.internal.http.socketTimeout=120000 \
              -PappVersion.runNumber="$APPVERSION_RUN_NUMBER" \
              -PappVersion.tag="$APPVERSION_TAG" \
              -PappVersion.releaseName="$APPVERSION_RELEASE_NAME" \
              webApp:wasmJsBrowserDistribution

# Runtime stage is intentionally metadata-only (COPY + CMD, no RUN) so that
# buildx can produce per-arch manifests without any QEMU binfmt handler.
# nginx:1.30 is already a multi-arch manifest, so omitting --platform lets
# buildx pick the correct per-target base for amd64 / arm64 / arm/v7.
FROM nginx:1.30 AS runtime

# Serve the Kotlin/Wasm production bundle directly from Nginx.
COPY --from=builder /workspace/webApp/build/dist/wasmJs/productionExecutable/ /usr/share/nginx/html/

# Replace the stock default.conf wholesale (port 8080, dual-stack) via a
# BuildKit heredoc — avoids a target-arch `RUN sed` that would otherwise
# require QEMU under multi-arch buildx.
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen       8080;
    listen       [::]:8080;
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html index.htm;

    # Unhashed files that change every build. `no-cache` forces revalidation
    # so a previous SW / HTTP cache cannot keep serving an old byte-identical
    # copy of the worker or the JS loader.
    location = /service-worker.js {
        add_header Cache-Control "no-cache";
    }

    location = /interfold-sw.js {
        add_header Cache-Control "no-cache";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location = /interfold-app.js {
        add_header Cache-Control "no-cache";
    }

    # Regenerated at container start from INTERFOLD_DEFAULT_API_ENDPOINT.
    location = /runtime-config.js {
        add_header Cache-Control "no-store";
    }

    # Content-hashed Kotlin/Wasm blobs (e.g. 5d9ec0de….wasm).
    location ~* \.wasm$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        # SPA fallback for OAuth redirect routes owned by the client
        # (/auth/token, /link_success/*). Query string is preserved.
        try_files  $uri $uri/ /index.html;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
EOF

# The image entrypoint runs envsubst on /etc/nginx/templates/*.template.
# This output dir is the web root, so do not add nginx config templates here:
# they would be written next to the Wasm bundle instead of conf.d.
# INTERFOLD_DEFAULT_API_ENDPOINT is set (empty) so an unset override still
# renders a valid script. Browsers that already saved an endpoint keep it.
ENV NGINX_ENVSUBST_OUTPUT_DIR=/usr/share/nginx/html
ENV NGINX_ENVSUBST_FILTER=^INTERFOLD_DEFAULT_API_ENDPOINT$
ENV INTERFOLD_DEFAULT_API_ENDPOINT=

COPY <<'EOF' /etc/nginx/templates/runtime-config.js.template
globalThis.__INTERFOLD_DEFAULT_API_ENDPOINT__ = "${INTERFOLD_DEFAULT_API_ENDPOINT}";
EOF

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
